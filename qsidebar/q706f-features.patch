+/* 读当前 sink 音量百分比（经 pactl） */
+static int get_volume_percentage(void) {
+    FILE *fp = popen("pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | head -1", "r");
+    if (!fp) return 0;
+    char buf[512] = {0};
+    int pct = -1;
+    if (fgets(buf, sizeof(buf) - 1, fp)) {
+        char *q = strchr(buf, '%');
+        if (q) {                       /* 往回找数字 */
+            char *p = q;
+            while (p > buf && (*(p-1) >= '0' && *(p-1) <= '9')) p--;
+            if (p < q) pct = atoi(p);
+        }
+    }
+    pclose(fp);
+    return pct < 0 ? 0 : pct;
+}
+
+/* 设 sink 音量（强制不超过 MAX_VOLUME_PCT） */
+static void set_volume_percentage(double value) {
+    if (value > MAX_VOLUME_PCT) value = MAX_VOLUME_PCT;
+    if (value < 0.0) value = 0.0;
+    char cmd[256];
+    snprintf(cmd, sizeof(cmd),
+             "pactl set-sink-volume @DEFAULT_SINK@ %d%% 2>/dev/null", (int)(value + 0.5));
+    if (system(cmd) != 0) { /* 忽略 */ }
+}
+
+static void volume_slider_changed(GtkRange *range, gpointer user_data) {
+    (void)user_data;
+    double v = gtk_range_get_value(range);
+    if (v > MAX_VOLUME_PCT) {          /* 拖过头就弹回上限 */
+        gtk_range_set_value(range, MAX_VOLUME_PCT);
+        v = MAX_VOLUME_PCT;
+    }
+    set_volume_percentage(v);
+}
+
 static void slider_changed(GtkRange *range, gpointer user_data) {
     (void)user_data;
     double value = gtk_range_get_value(range);
     set_brightness_percentage(value);
 }
 
+/* ===== 动态按钮文字：执行 label_cmd，把输出贴到按钮上 ===== */
+static gboolean update_button_label(gpointer data) {
+    ButtonConfig *cfg = (ButtonConfig *)data;
+    if (!cfg || !cfg->label_cmd[0] || !cfg->label_widget) return G_SOURCE_REMOVE;
+    char full_cmd[MAX_LINE_LENGTH * 2];
+    if (cfg->label_cmd[0] == '/')
+        snprintf(full_cmd, sizeof(full_cmd), "%s", cfg->label_cmd);
+    else
+        snprintf(full_cmd, sizeof(full_cmd), "%s%s", SCRIPT_PATH, cfg->label_cmd);
+    FILE *fp = popen(full_cmd, "r");
+    if (!fp) return G_SOURCE_CONTINUE;
+    char out[MAX_LINE_LENGTH] = {0};
+    if (fgets(out, sizeof(out) - 1, fp)) {
+        size_t L = strlen(out);
+        while (L && (out[L-1] == '\n' || out[L-1] == '\r' || out[L-1] == ' ')) out[--L] = '\0';
+        if (out[0]) gtk_label_set_text(GTK_LABEL(cfg->label_widget), out);
+    }
+    pclose(fp);
+    return G_SOURCE_CONTINUE;
+}
+
+static void start_label_timer(ButtonConfig *cfg) {
+    if (!cfg || !cfg->label_cmd[0] || !cfg->label_widget) return;
+    update_button_label(cfg);
+    if (cfg->label_timer) g_source_remove(cfg->label_timer);
+    cfg->label_timer = g_timeout_add_seconds(cfg->label_interval > 0 ? cfg->label_interval : 5,
+                                             update_button_label, cfg);
+}
